# Copy to .env and edit. All settings are WHISK_-prefixed; see backend/app/config.py.

# --- runtime mode ----------------------------------------------------------
# local = no GCP calls at all (fake model + fake data plane, real agent loop)
# gcp   = real Vertex AI, Firestore and Cloud Storage
WHISK_MODE=local

# --- GCP wiring (required when WHISK_MODE=gcp) -----------------------------
WHISK_PROJECT_ID=
WHISK_LOCATION=us-central1
WHISK_GCS_BUCKET=
WHISK_FIRESTORE_DATABASE=(default)

# --- models ----------------------------------------------------------------
# Flash is the right tier for tool turns: pick a tool, fill three arguments,
# write one sentence. Pro is the escalation path for long grounded reasoning.
WHISK_AGENT_MODEL=gemini-3.6-flash
WHISK_PRO_MODEL=gemini-3.1-pro-preview
WHISK_EMBEDDING_MODEL=text-embedding-005
WHISK_EMBEDDING_DIM=768

# --- image generation (Replicate / AnimagineXL 3.1) ------------------------
# The only generator. On Cloud Run this is injected from Secret Manager via
# --set-secrets, so the process just reads an env var. Never sent to a browser.
# The model version is pinned by hash in backend/app/providers/replicate.py.
WHISK_REPLICATE_API_TOKEN=
# Synchronous window before falling back to client polling. Small on purpose:
# Cloud Run bills CPU for the whole request duration, so waiting out a 60s cold
# GPU boot costs ~12x a 5s wait and holds a concurrency slot the entire time.
WHISK_REPLICATE_WAIT_SECONDS=5

# --- auth ------------------------------------------------------------------
# Identity Platform is the Cognito equivalent. In local mode identity is a
# request header instead; that path is unreachable when mode=gcp.
WHISK_AUTH_REQUIRED=false
WHISK_IDENTITY_PLATFORM_PROJECT=
# Public Web API key (Identity Platform -> Application Setup Details). Safe in a
# browser: it identifies the project and authorises nothing on its own, exactly
# like the Firebase SDK config object. Served via /config.json.
WHISK_IDENTITY_PLATFORM_API_KEY=

# --- guardrails (per user) -------------------------------------------------
WHISK_RATE_CAPACITY=30
WHISK_RATE_REFILL_SECONDS=2.0
WHISK_DAILY_TOKEN_CAP=200000
WHISK_DAILY_IMAGE_CAP=50

# --- surfaces --------------------------------------------------------------
WHISK_ENABLE_A2A=true
WHISK_ENABLE_MCP=true

# The public origin. Deployed, this is the Firebase Hosting site (NOT the Cloud
# Run URL) -- Hosting proxies /api to Cloud Run, so that is the host users and
# A2A peers actually see. It also feeds MCP's DNS-rebinding allow-list, which
# 421s any host it does not know.
WHISK_PUBLIC_BASE_URL=http://localhost:8080

# Point at a separately-deployed critic to exercise the real A2A round-trip.
# Unset, the critic runs in-process (the right call for a co-located agent).
# WHISK_CRITIC_A2A_URL=

WHISK_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- paths -----------------------------------------------------------------
WHISK_CORPUS_DIR=../docs
WHISK_FRONTEND_DIST=../frontend/dist
WHISK_LOCAL_MEDIA_DIR=.localdata/media
